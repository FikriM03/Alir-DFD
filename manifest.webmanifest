{
  "name": "Alir - DFD & UML",
  "short_name": "Alir",
  "description": "Editor DFD (berkas .pam PowerDesigner 6) serta Activity, Use Case, dan BPMN yang bisa diekspor ke Enterprise Architect.",
  "lang": "id",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#14284a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-alir": [
          ".alir"
        ],
        "application/x-powerdesigner-pam": [
          ".pam"
        ],
        "application/x-ea-project": [
          ".eap"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "auto"
  }
}